# ==============================================================================
# SpanQC - Wiring Diagram QC Assistant: Environment Configuration (.env.example)
# Never commit real production credentials to version control.
# ==============================================================================

# Application Runtime Mode: "PRODUCTION" | "DEMO" | "TEST"
# Staging environments should run with APP_MODE="PRODUCTION" or "DEMO"
APP_MODE="PRODUCTION"

# Database Connection (PostgreSQL with pooled and direct connection strings)
# Neon, Supabase, AWS RDS, or self-hosted PostgreSQL
DATABASE_URL="postgresql://qc_user:secure_password@ep-db-pooler.us-east-2.aws.neon.tech/spanqc?sslmode=require"
DIRECT_URL="postgresql://qc_user:secure_password@ep-db-direct.us-east-2.aws.neon.tech/spanqc?sslmode=require"

# Session & Security (Must be cryptographically random string >= 32 characters in production)
AUTH_SECRET="change-this-to-a-cryptographically-random-string-at-least-32-chars-long"
NEXT_PUBLIC_APP_URL="https://staging.spanqc.com"

# Private S3-Compatible Object Storage (AWS S3, Cloudflare R2, MinIO)
# Supports either AWS_* or STORAGE_* prefixes
AWS_S3_BUCKET="spanqc-staging-documents"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT="" # Leave empty for AWS S3. Set for MinIO or Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com

# Alternative STORAGE_* aliases:
# STORAGE_BUCKET="spanqc-staging-documents"
# STORAGE_REGION="us-east-1"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_ENDPOINT=""

# Optional Private Local Storage Directory (used only if S3 credentials are not set)
# PRIVATE_STORAGE_PATH="./.private_storage"

# Razorpay Test Configuration (BILLING_STATUS = NOT_LIVE)
# In staging, use Razorpay Test credentials (starts with rzp_test_)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="rzp_test_placeholder_webhook_secret"

# Optional AI / OCR Extraction Engine (Ollama / Local Vision)
# Deterministic QC rules do NOT rely on LLM decision-making.
# OLLAMA_ENDPOINT="http://localhost:11434"
# OLLAMA_MODEL="qwen2.5-vl:3b"
