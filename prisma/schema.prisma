generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// 1. ORGANIZATIONS / TENANTS
// -------------------------------------------------------------
model Tenant {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  status          String               @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  plan            String               @default("NORMAL_1") // NORMAL_1 ($1/₹99), MID_5 ($5/₹499), MAX_10 ($10/₹999)
  checkQuota      Int                  @default(100)
  quotaUsed       Int                  @default(0)
  users           User[]
  workspaces      Workspace[]
  projects        Project[]
  documents       Document[]
  diagrams        Diagram[]
  inspections     Inspection[]
  reports         Report[]
  sopRules        CustomSopRule[]
  feedbackEntries RegressionFeedback[]
  subscriptions   Subscription[]
  paymentOrders   PaymentOrder[]
  usageLedgers    UsageLedger[]
  entitlements    Entitlement[]
  auditEvents     AuditEvent[]
  aiRuns          AiRun[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("organizations")
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  name           String
  phone          String?
  passwordHash   String?
  status         String               @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED
  role           String               @default("QC_INSPECTOR") // OWNER, ADMIN, QC_MANAGER, QC_INSPECTOR, VIEWER
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships    OrganizationMember[]
  findingReviews FindingReview[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("users")
}

model OrganizationMember {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@map("organization_members")
}

// -------------------------------------------------------------
// 2. PROJECTS & WORKSPACES
// -------------------------------------------------------------
model Workspace {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  diagrams  Diagram[]
  createdAt DateTime  @default(now())

  @@map("workspaces")
}

model Project {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String     @default("ACTIVE") // ACTIVE, ARCHIVED
  documents   Document[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("projects")
}

// -------------------------------------------------------------
// 3. DOCUMENTS & VERSIONING
// -------------------------------------------------------------
model Document {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  status     String            @default("UPLOADED") // UPLOADING, UPLOADED, QUEUED, PROCESSING, REVIEW_REQUIRED, COMPLETED, FAILED
  checksum   String?
  createdBy  String?
  versions   DocumentVersion[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("documents")
}

model DocumentVersion {
  id               String         @id @default(uuid())
  documentId       String
  document         Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version          Int            @default(1)
  storageKey       String
  processingStatus String         @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  parserVersion    String         @default("1.0.0")
  pages            DocumentPage[]
  components       Component[]
  connections      Connection[]
  findings         Finding[]
  reports          Report[]
  aiRuns           AiRun[]
  createdAt        DateTime       @default(now())

  @@map("document_versions")
}

model DocumentPage {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  pageNumber        Int
  imageStorageKey   String
  width             Int             @default(1920)
  height            Int             @default(1080)
  extractedText     String?
  ocrMetadata       String?         // Serialized JSONB
  components        Component[]
  createdAt         DateTime        @default(now())

  @@map("document_pages")
}

// -------------------------------------------------------------
// 4. COMPONENTS, TERMINALS, & CONNECTIONS (ELECTRICAL GRAPH)
// -------------------------------------------------------------
model Component {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  pageId            String?
  page              DocumentPage?   @relation(fields: [pageId], references: [id], onDelete: SetNull)
  componentRef      String          // e.g. "J1", "K1", "CB-MAIN"
  componentType     String          // CONNECTOR, RELAY, BREAKER, POWER, GROUND, SENSOR
  bbox              String?         // JSONB: { x, y, width, height }
  confidence        Float           @default(0.95)
  attributes        String?         // JSONB
  terminals         Terminal[]
  createdAt         DateTime        @default(now())

  @@map("components")
}

model Terminal {
  id                String       @id @default(uuid())
  componentId       String
  component         Component    @relation(fields: [componentId], references: [id], onDelete: Cascade)
  terminalRef       String       // e.g. "Pin 1", "Coil 85", "Stud M8"
  bbox              String?      // JSONB
  confidence        Float        @default(0.95)
  sourceConnections Connection[] @relation("SourceTerminal")
  targetConnections Connection[] @relation("TargetTerminal")
  createdAt         DateTime     @default(now())

  @@map("terminals")
}

model Connection {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  sourceTerminalId  String
  sourceTerminal    Terminal        @relation("SourceTerminal", fields: [sourceTerminalId], references: [id], onDelete: Cascade)
  targetTerminalId  String
  targetTerminal    Terminal        @relation("TargetTerminal", fields: [targetTerminalId], references: [id], onDelete: Cascade)
  netName           String          // e.g. "W-101 (+24VDC)"
  geometry          String?         // JSONB: orthogonal SVG path points
  confidence        Float           @default(0.95)
  createdAt         DateTime        @default(now())

  @@map("connections")
}

// -------------------------------------------------------------
// 5. STANDARDS & RULES ENGINE
// -------------------------------------------------------------
model Standard {
  id              String           @id @default(uuid())
  name            String           @unique // e.g. "IPC/WHMA-A-620", "UL 508A"
  version         String           @default("3rd Edition")
  jurisdiction    String           @default("INTERNATIONAL")
  sourceUri       String?
  licenseMetadata String?          // JSONB
  clauses         StandardClause[]
  createdAt       DateTime         @default(now())

  @@map("standards")
}

model StandardClause {
  id                String   @id @default(uuid())
  standardId        String
  standard          Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  clauseRef         String   // e.g. "§4.2.1", "§13.4", "Table 15.1"
  title             String
  authorizedContent String
  metadata          String?  // JSONB
  createdAt         DateTime @default(now())

  @@map("standard_clauses")
}

model Rule {
  id            String    @id @default(uuid())
  code          String    @unique // e.g. "IPC-AMP-001", "UL508A-GND-002"
  name          String
  version       String    @default("1.0.0")
  severity      String    @default("CRITICAL") // CRITICAL, MAJOR, MINOR, ADVISORY
  applicability String?   // JSONB: { standards: ["IPC-620"], classes: ["CLASS_3"] }
  definition    String?   // JSONB
  enabled       Boolean   @default(true)
  findings      Finding[]
  createdAt     DateTime  @default(now())

  @@map("rules")
}

// -------------------------------------------------------------
// 6. FINDINGS & HUMAN REVIEW
// -------------------------------------------------------------
model Finding {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  ruleId            String?
  rule              Rule?           @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  status            String          @default("UNREVIEWED") // UNREVIEWED, CONFIRMED, REJECTED, MODIFIED, NEEDS_MORE_EVIDENCE
  severity          String          @default("MAJOR") // CRITICAL, MAJOR, MINOR, ADVISORY
  description       String
  confidence        Float           @default(0.95)
  evidence          String?         // JSONB: array of bounding boxes and extracted text
  aiRunId           String?
  aiRun             AiRun?          @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  reviews           FindingReview[]
  createdAt         DateTime        @default(now())

  @@map("findings")
}

model FindingReview {
  id         String   @id @default(uuid())
  findingId  String
  finding    Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  decision   String   // CONFIRMED, REJECTED, MODIFIED, NEEDS_MORE_EVIDENCE
  comment    String?
  createdAt  DateTime @default(now())

  @@map("finding_reviews")
}

// -------------------------------------------------------------
// 7. AI RUN TELEMETRY & AUDIT
// -------------------------------------------------------------
model AiRun {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  provider          String           @default("ollama") // "ollama", "bedrock", "openai", "gemini"
  model             String           @default("qwen2.5-vl:3b")
  promptVersion     String           @default("1.0.0")
  inputHash         String?
  output            String?          // Serialized JSONB
  tokenUsage        String?          // JSONB: { promptTokens, completionTokens, totalTokens }
  latencyMs         Int              @default(0)
  costMinorUnits    Int              @default(0) // in minor units
  findings          Finding[]
  createdAt         DateTime         @default(now())

  @@map("ai_runs")
}

// -------------------------------------------------------------
// 8. REPORTS (PDF & XLSX)
// -------------------------------------------------------------
model Report {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  reportVersion     String           @default("1.0.0")
  pdfStorageKey     String?
  xlsxStorageKey    String?
  generatedBy       String?
  createdAt         DateTime         @default(now())

  @@map("reports")
}

// -------------------------------------------------------------
// 9. RAZORPAY BILLING & MONETIZATION (Integer Minor Units)
// -------------------------------------------------------------
model Plan {
  id              String         @id @default(uuid())
  code            String         @unique // "PAY_PER_CHECK", "PRO_MONTHLY", "PRO_ANNUAL", "ENTERPRISE"
  name            String
  billingInterval String         // "ONE_TIME", "MONTHLY", "ANNUAL"
  priceMinor      Int            // 9900 (₹99), 49900 (₹499), 99900 (₹999) in integer paise
  currency        String         @default("INR") // "INR", "USD"
  includedChecks  Int            @default(100)
  features        String?        // JSONB: feature list
  active          Boolean        @default(true)
  subscriptions   Subscription[]
  paymentOrders   PaymentOrder[]
  createdAt       DateTime       @default(now())

  @@map("plans")
}

model Subscription {
  id                     String    @id @default(uuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  provider               String    @default("razorpay") // "razorpay", "stripe"
  providerSubscriptionId String?   @unique
  status                 String    @default("ACTIVE") // CREATED, AUTHENTICATION_PENDING, ACTIVE, PAUSED, PAST_DUE, CANCELLED, EXPIRED
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("subscriptions")
}

model PaymentOrder {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  provider        String    @default("razorpay")
  providerOrderId String?   @unique // Razorpay order_id, e.g. "order_EKf3Ow6eLAipAq"
  amountMinor     Int       // e.g. 49900
  currency        String    @default("INR")
  status          String    @default("CREATED") // CREATED, PENDING, ATTEMPTED, PAID, FAILED, EXPIRED
  idempotencyKey  String?   @unique
  payments        Payment[]
  createdAt       DateTime  @default(now())

  @@map("payment_orders")
}

model Payment {
  id                String       @id @default(uuid())
  paymentOrderId    String
  paymentOrder      PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  providerPaymentId String       @unique // e.g. "pay_29Mo33dLLeQbCW"
  method            String       @default("UPI") // "UPI", "CARD", "NETBANKING", "WALLET"
  status            String       @default("CAPTURED") // AUTHORIZED, CAPTURED, FAILED, REFUNDED
  amountMinor       Int          // e.g. 49900
  capturedAt        DateTime?
  rawReference      String?      // Serialized JSONB gateway response
  refunds           Refund[]
  createdAt         DateTime     @default(now())

  @@map("payments")
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerRefundId String   @unique // e.g. "rfnd_8x9..."
  amountMinor      Int
  status           String   @default("PROCESSED") // PROCESSED, FAILED
  reason           String?
  createdAt        DateTime @default(now())

  @@map("refunds")
}

model PaymentWebhook {
  id             String   @id @default(uuid())
  provider       String   @default("razorpay")
  eventId        String   // Razorpay event ID, e.g. "event_98sdfjkl"
  eventType      String   // "order.paid", "payment.captured", "subscription.charged", etc.
  signatureValid Boolean  @default(true)
  payloadHash    String
  processedAt    DateTime @default(now())
  status         String   @default("PROCESSED") // PROCESSED, DUPLICATE_SKIPPED, FAILED
  error          String?

  @@unique([provider, eventId])
  @@map("payment_webhooks")
}

model UsageLedger {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType     String   // "DIAGRAM_INSPECTED", "CHECKS_PROVISIONED", "MANUAL_RELOAD"
  quantity      Int      // +100, -1, etc.
  referenceType String?  // "PAYMENT", "INSPECTION", "SUBSCRIPTION"
  referenceId   String?  // related record ID
  createdAt     DateTime @default(now())

  @@map("usage_ledger")
}

model Entitlement {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureCode String    // "DIAGRAM_CHECKS", "EXPORT_XLSX", "CAD_LIVE_DRC", "API_ACCESS"
  quantity    Int       @default(100)
  consumed    Int       @default(0)
  periodStart DateTime  @default(now())
  periodEnd   DateTime?

  @@map("entitlements")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String   // "AUTH_LOGIN", "PAYMENT_CAPTURE", "DOCUMENT_UPLOAD", "RULE_MODIFIED"
  entityType String   // "DOCUMENT", "PAYMENT", "FINDING", "USER"
  entityId   String?
  metadata   String?  // JSONB
  ipHash     String?
  createdAt  DateTime @default(now())

  @@map("audit_events")
}

// -------------------------------------------------------------
// 10. LEGACY EXTENSIONS (PRESERVED FOR BACKWARD COMPATIBILITY)
// -------------------------------------------------------------
model Diagram {
  id            String       @id @default(uuid())
  title         String
  standard      String
  category      String
  fileUrl       String?
  svgData       String?
  schematicJson String?
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId   String?
  workspace     Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  inspections   Inspection[]
  createdAt     DateTime     @default(now())

  @@map("diagrams")
}

model Inspection {
  id                String   @id @default(uuid())
  reportId          String   @unique
  diagramId         String?
  diagram           Diagram? @relation(fields: [diagramId], references: [id], onDelete: SetNull)
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  overallResult     String   // PASS or FAIL
  qualityScore      Int
  summaryJson       String
  discrepanciesJson String
  modelUsed         String
  executionTimeMs   Int
  operator          String
  createdAt         DateTime @default(now())

  @@map("inspections")
}

model CustomSopRule {
  id          String   @id @default(uuid())
  ruleCode    String
  title       String
  description String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("custom_sop_rules")
}

model RegressionFeedback {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discrepancyId String
  status        String
  category      String
  notes         String?
  createdAt     DateTime @default(now())

  @@map("regression_feedbacks")
}
